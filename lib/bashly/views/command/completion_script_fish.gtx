= view_marker

> send_completions_fish() {
>   echo $'function _{{ name.to_underscore }}_completions'
>   echo $'  set --local completion_tokens (commandline --current-process --tokenize --cut-at-cursor)'
>   echo $'  set --local completion_current (commandline --current-token --cut-at-cursor)'
>   echo $'  set --local completion_command $completion_tokens[1]'
>   echo $'  set --local completion_words'
>   echo $''
>   echo $'  if test (count $completion_tokens) -gt 1'
>   echo $'    set completion_words $completion_tokens[2..-1]'
>   echo $'  end'
>   echo $''
>   echo $'  set --local completion_response ($completion_command __complete $completion_words "$completion_current")'
>   echo $'  set --query completion_response[1]; or return'
>   echo $''
>   echo $'  set --local completion_directive $completion_response[-1]'
>   echo $'  set --local completion_options'
>   echo $''
>   echo $'  if string match --quiet --regex "^:options=" -- $completion_directive'
>   echo $'    set --erase completion_response[-1]'
>   echo $'    set completion_options (string split --no-empty , -- (string replace --regex "^:options=" "" -- $completion_directive))'
>   echo $'  end'
>   echo $''
>   echo $'  set --local completion_files false'
>   echo $'  set --local completion_directories false'
>   echo $'  set --local completion_no_space false'
>   echo $''
>   echo $'  for completion_option in $completion_options'
>   echo $'    switch $completion_option'
>   echo $'      case files'
>   echo $'        set completion_files true'
>   echo $'      case directories'
>   echo $'        set completion_directories true'
>   echo $'      case no-space'
>   echo $'        set completion_no_space true'
>   echo $'    end'
>   echo $'  end'
>   echo $''
>   echo $'  set --local completion_candidates $completion_response'
>   echo $''
>   echo $'  if test $completion_files = true'
>   echo $'    set --append completion_candidates (__fish_complete_path "$completion_current")'
>   echo $'  else if test $completion_directories = true'
>   echo $'    set --append completion_candidates (__fish_complete_directories "$completion_current")'
>   echo $'  end'
>   echo $''
>   echo $'  # fish has no no-space directive, but it appends a space only to a'
>   echo $'  # unique candidate, so a second candidate suppresses it'
>   echo $'  if test $completion_no_space = true; and test (count $completion_candidates) -eq 1'
>   echo $'    set --append completion_candidates "$completion_candidates[1] "'
>   echo $'  end'
>   echo $''
>   echo $'  if set --query completion_candidates[1]'
>   echo $'    printf \'%s\\n\' $completion_candidates'
>   echo $'  end'
>   echo $'end'
>   echo $''
>   echo $'complete --command {{ name }} --no-files --arguments "(_{{ name.to_underscore }}_completions)"'
> }
