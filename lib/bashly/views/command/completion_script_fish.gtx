= view_marker

> send_completions_fish() {
>   printf '%s\n' $'function _{{ name.to_underscore }}_completions'
>   printf '%s\n' $'  set --local completion_tokens (commandline --current-process --tokenize --cut-at-cursor)'
>   printf '%s\n' $'  set --local completion_current (commandline --current-token --cut-at-cursor)'
>   printf '%s\n' $'  set --local completion_command $completion_tokens[1]'
>   printf '%s\n' $'  set --local completion_words'
>   printf '%s\n' $''
>   printf '%s\n' $'  if test (count $completion_tokens) -gt 1'
>   printf '%s\n' $'    set completion_words $completion_tokens[2..-1]'
>   printf '%s\n' $'  end'
>   printf '%s\n' $''
>   printf '%s\n' $'  set --local completion_response ($completion_command __complete $completion_words "$completion_current")'
>   printf '%s\n' $'  set --query completion_response[1]; or return'
>   printf '%s\n' $''
>   printf '%s\n' $'  set --local completion_directive $completion_response[-1]'
>   printf '%s\n' $'  set --local completion_options'
>   printf '%s\n' $''
>   printf '%s\n' $'  if string match --quiet --regex "^:options=" -- $completion_directive'
>   printf '%s\n' $'    set --erase completion_response[-1]'
>   printf '%s\n' $'    set completion_options (string split --no-empty , -- (string replace --regex "^:options=" "" -- $completion_directive))'
>   printf '%s\n' $'  end'
>   printf '%s\n' $''
>   printf '%s\n' $'  set --local completion_files false'
>   printf '%s\n' $'  set --local completion_directories false'
>   printf '%s\n' $'  set --local completion_no_space false'
>   printf '%s\n' $''
>   printf '%s\n' $'  for completion_option in $completion_options'
>   printf '%s\n' $'    switch $completion_option'
>   printf '%s\n' $'      case files'
>   printf '%s\n' $'        set completion_files true'
>   printf '%s\n' $'      case directories'
>   printf '%s\n' $'        set completion_directories true'
>   printf '%s\n' $'      case no-space'
>   printf '%s\n' $'        set completion_no_space true'
>   printf '%s\n' $'    end'
>   printf '%s\n' $'  end'
>   printf '%s\n' $''
>   printf '%s\n' $'  set --local completion_candidates $completion_response'
>   printf '%s\n' $'  set --local completion_paths'
>   printf '%s\n' $''
>   printf '%s\n' $'  if test $completion_files = true'
>   printf '%s\n' $'    set completion_paths (__fish_complete_path "$completion_current")'
>   printf '%s\n' $'  else if test $completion_directories = true'
>   printf '%s\n' $'    set completion_paths (__fish_complete_directories "$completion_current")'
>   printf '%s\n' $'  end'
>   printf '%s\n' $''
>   printf '%s\n' $'  # path candidates carry a tab-separated description, and older fish'
>   printf '%s\n' $'  # versions do not deduplicate candidates on their own'
>   printf '%s\n' $'  for completion_path in $completion_paths'
>   printf '%s\n' $'    if not contains -- (string replace --regex \'\\t.*\' \'\' -- $completion_path) $completion_response'
>   printf '%s\n' $'      set --append completion_candidates $completion_path'
>   printf '%s\n' $'    end'
>   printf '%s\n' $'  end'
>   printf '%s\n' $''
>   printf '%s\n' $'  # fish has no no-space directive, but it appends a space only to a'
>   printf '%s\n' $'  # unique candidate, so a second candidate suppresses it'
>   printf '%s\n' $'  if test $completion_no_space = true; and test (count $completion_candidates) -eq 1'
>   printf '%s\n' $'    set --append completion_candidates "$completion_candidates[1] "'
>   printf '%s\n' $'  end'
>   printf '%s\n' $''
>   printf '%s\n' $'  if set --query completion_candidates[1]'
>   printf '%s\n' $'    printf \'%s\\n\' $completion_candidates'
>   printf '%s\n' $'  end'
>   printf '%s\n' $'end'
>   printf '%s\n' $''
>   printf '%s\n' $'complete --command {{ name }} --no-files --arguments "(_{{ name.to_underscore }}_completions)"'
> }
